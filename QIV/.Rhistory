paz_x = a*pa_zx*fz_x + (1-a)*(1-pa_zx)*fz_x
#marginalize out z
y_L = Ey_z1*pz_x + Ey_z0*(1-pz_x)
p_Y_0 = y_L - psi*pa_x - phi_1*pz_x
df_ = data.frame(pi_1,
pi_0,
phi_1,
phi_0,
psi,
p_Y_0,
pz_x,
pa_x,
paz_x)
return(cbind(data_pred,df_))
}
