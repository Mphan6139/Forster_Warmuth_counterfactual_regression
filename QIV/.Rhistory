clean_stratify <- function(df_in){
get_history <- function(df_){
df_ = df_[order(df_$t1_),]
i_1 = which(df_$inactive == 1)[1]
n = nrow(df_)
if(is.na(i_1)){
df_$history = rep.int(0,n)
}else{
df_$history = c(rep.int(0,i_1),rep.int(1,n-i_1))
}
return(df_)
}
df_out = data.frame(do.call("rbind", by(df_in, as.factor(df_in$WL_ID_CODE), get_history)), row.names = NULL)
return(df_out)
}
