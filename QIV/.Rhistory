pi_0 = predict(model_a_z, data.frame(X,z=0))[[1]]
#marginalize Z in A|Z,X
pa_x = pi_1*pz_x + pi_0*(1-pz_x)
Ey_a1z1 = predict(model_y_za, data.frame(X,z=1,a=1))[[1]]
