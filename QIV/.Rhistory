factorize = function(df){
df$blood = factor(df$blood,levels = c("O","A", "AB", "B"))
df$REGION = factor(df$REGION,levels = c(5,1,2,3,4,6,7,8,9,10,11))
df$opo_num = factor(df$opo_num)
df$list_ctr = factor(df$list_ctr)
return(df)
}
create_pred_vec = function(df,model){
pred_terms = predict(model, newdata = df,type="terms")
preds = rowSums(pred_terms)
df$preds = preds
temp = aggregate(.~WL_ID_CODE, df[,c("WL_ID_CODE","preds")], FUN=head, 1)
pred_v = temp$preds
names(pred_v) = temp$WL_ID_CODE
return(pred_v)
}
